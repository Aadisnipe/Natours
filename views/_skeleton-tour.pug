//-Skeleton for tour detail page
main
  section.skeleton-section-header
    .skeleton-header-hero
    .skeleton-heading-box
      .skeleton-heading-primary
      .skeleton-heading-group
        .skeleton-heading-detail
        .skeleton-heading-detail

  section.skeleton-section-description
    .skeleton-overview-box
      div
        .skeleton-overview-group
          .skeleton-overview-heading
          each i in [1, 2, 3, 4]
            .skeleton-overview-detail
              .skeleton-overview-icon
              .skeleton-overview-text-group
                .skeleton-overview-label
                .skeleton-overview-text

        .skeleton-overview-group
          .skeleton-overview-heading
          each i in [1, 2, 3]
            .skeleton-overview-detail
              .skeleton-overview-icon
              .skeleton-overview-text-group
                .skeleton-overview-label
                .skeleton-overview-text

    .skeleton-description-box
      .skeleton-description-heading
      .skeleton-description-text
      .skeleton-description-text
      .skeleton-description-text

  section.skeleton-section-pictures
    each i in [1, 2, 3]
      .skeleton-picture-box

  .skeleton-section-map

  section.skeleton-section-reviews
    .skeleton-reviews-container
      each i in [1, 2, 3]
        .skeleton-review-card
          .skeleton-review-header
            .skeleton-review-avatar
            .skeleton-review-name
          .skeleton-review-text
          .skeleton-review-text
          .skeleton-review-rating
            each j in [1, 2, 3, 4, 5]
              .skeleton-review-star
