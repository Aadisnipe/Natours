//-Skeleton for account page
main.main
  .skeleton-account-container
    nav.user-view__menu
      ul.side-nav
        each i in [1, 2, 3, 4]
          li
            .skeleton-nav-item

      .admin-nav
        h5.admin-nav__heading Admin
        ul.side-nav
          each i in [1, 2, 3, 4]
            li
              .skeleton-nav-item

    .user-view__content
      .skeleton-user-form-container
        .skeleton-form-heading
        each i in [1, 2, 3]
          .skeleton-form-group
            .skeleton-form-label
            .skeleton-form-input
        .skeleton-form-button

      .line &nbsp;

      .skeleton-user-form-container
        .skeleton-form-heading
        each i in [1, 2, 3]
          .skeleton-form-group
            .skeleton-form-label
            .skeleton-form-input
        .skeleton-form-button
